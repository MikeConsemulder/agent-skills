{
  "grid": {
    "base": { "$type": "dimension", "$value": "4px" }
  },
  "color": {
    "brand": {
      "primary": { "$type": "color", "$value": "#1D4ED8" },
      "primary-hover": { "$type": "color", "$value": "#1E40AF" },
      "on-primary": { "$type": "color", "$value": "#FFFFFF" }
    },
    "text": {
      "default": { "$type": "color", "$value": "#111827" },
      "muted": { "$type": "color", "$value": "#4B5563" },
      "inverse": { "$type": "color", "$value": "#FFFFFF" }
    },
    "surface": {
      "default": { "$type": "color", "$value": "#FFFFFF" },
      "subtle": { "$type": "color", "$value": "#F3F4F6" }
    },
    "border": {
      "default": { "$type": "color", "$value": "#6B7280" }
    },
    "feedback": {
      "error": { "$type": "color", "$value": "#B91C1C" },
      "success": { "$type": "color", "$value": "#15803D" },
      "warning": { "$type": "color", "$value": "#A16207" }
    },
    "focus": {
      "ring": { "$type": "color", "$value": "#2563EB" }
    }
  },
  "spacing": {
    "0": { "$type": "dimension", "$value": "0px" },
    "1": { "$type": "dimension", "$value": "4px" },
    "2": { "$type": "dimension", "$value": "8px" },
    "3": { "$type": "dimension", "$value": "12px" },
    "4": { "$type": "dimension", "$value": "16px" },
    "6": { "$type": "dimension", "$value": "24px" },
    "8": { "$type": "dimension", "$value": "32px" },
    "12": { "$type": "dimension", "$value": "48px" },
    "16": { "$type": "dimension", "$value": "64px" }
  },
  "radius": {
    "sm": { "$type": "dimension", "$value": "4px" },
    "md": { "$type": "dimension", "$value": "8px" },
    "full": { "$type": "dimension", "$value": "9999px" }
  },
  "font": {
    "family": {
      "sans": { "$type": "fontFamily", "$value": "Inter, system-ui, sans-serif" }
    },
    "size": {
      "sm": { "$type": "dimension", "$value": "14px" },
      "base": { "$type": "dimension", "$value": "16px" },
      "lg": { "$type": "dimension", "$value": "20px" },
      "xl": { "$type": "dimension", "$value": "24px" },
      "2xl": { "$type": "dimension", "$value": "32px" }
    },
    "weight": {
      "regular": { "$type": "fontWeight", "$value": 400 },
      "semibold": { "$type": "fontWeight", "$value": 600 },
      "bold": { "$type": "fontWeight", "$value": 700 }
    },
    "lineHeight": {
      "tight": { "$type": "number", "$value": 1.25 },
      "normal": { "$type": "number", "$value": 1.5 }
    }
  },
  "breakpoint": {
    "mobile": { "$type": "dimension", "$value": "360px" },
    "tablet": { "$type": "dimension", "$value": "768px" },
    "desktop": { "$type": "dimension", "$value": "1280px" }
  },
  "size": {
    "touch-target-min": { "$type": "dimension", "$value": "44px" }
  },
  "motion": {
    "duration": {
      "fast": { "$type": "duration", "$value": "150ms" },
      "base": { "$type": "duration", "$value": "250ms" }
    }
  },
  "$extensions": {
    "a11y": {
      "contrastPairs": [
        { "fg": "{color.text.default}", "bg": "{color.surface.default}", "use": "text" },
        { "fg": "{color.text.muted}", "bg": "{color.surface.default}", "use": "text" },
        { "fg": "{color.text.muted}", "bg": "{color.surface.subtle}", "use": "text" },
        { "fg": "{color.brand.on-primary}", "bg": "{color.brand.primary}", "use": "text" },
        { "fg": "{color.brand.on-primary}", "bg": "{color.brand.primary-hover}", "use": "text" },
        { "fg": "{color.feedback.error}", "bg": "{color.surface.default}", "use": "text" },
        { "fg": "{color.border.default}", "bg": "{color.surface.default}", "use": "ui" },
        { "fg": "{color.focus.ring}", "bg": "{color.surface.default}", "use": "ui" }
      ]
    }
  }
}
